{
  "wcat_manifest": 2,
  "name": "ydisk",
  "description": "Yandex Disk for your AI agents: chosen folders as searchable text, and the files live",
  "docs_url": "https://github.com/WireCatLabs/ydisk-cli#readme",
  "package": "@wirecat/yandex-disk-cli",
  "bin": "wcat-ydisk",
  "commands": [
    {
      "path": [
        "commands"
      ],
      "summary": "every command by section; --json prints its contract, one path per call",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "commands",
        "info"
      ],
      "summary": "one command contract, or all schemas, error reasons and explicit overrides",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "session",
        "start"
      ],
      "summary": "sign in to Yandex Disk with its OAuth token",
      "effects": {
        "remote": "read",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "status"
      ],
      "summary": "show where this profile's token comes from; never the token",
      "effects": {
        "remote": "read",
        "local": "read"
      }
    },
    {
      "path": [
        "session",
        "end"
      ],
      "summary": "forget this profile's token on this computer",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "list"
      ],
      "summary": "list the profiles here and whether each is signed in",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "account",
        "remove"
      ],
      "summary": "sign this profile out and forget it, keeping or deleting its data",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "account.remove",
      "entity": "account_removal"
    },
    {
      "path": [
        "folders",
        "add"
      ],
      "summary": "import a folder and everything under it on the next sync",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "folders.add"
    },
    {
      "path": [
        "folders",
        "list"
      ],
      "summary": "list the folder ids sync imports",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "folders.list",
      "entity": "selected_folder"
    },
    {
      "path": [
        "folders",
        "browse"
      ],
      "summary": "list Disk folders one level at a time, live, to choose one for folders add",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "folders.browse",
      "entity": "disk_item"
    },
    {
      "path": [
        "folders",
        "remove"
      ],
      "summary": "stop importing a folder; the next sync drops its documents",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "folders.remove"
    },
    {
      "path": [
        "sync"
      ],
      "summary": "import what changed in the chosen folders, and finish an unfinished sync",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "sync"
    },
    {
      "path": [
        "status"
      ],
      "summary": "show the last sync, imported documents and pending work",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "status"
    },
    {
      "path": [
        "documents",
        "list"
      ],
      "summary": "list the synced files with their Disk paths",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "documents.list",
      "entity": "document"
    },
    {
      "path": [
        "documents",
        "show"
      ],
      "summary": "show an imported document's text, tabs and metadata",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "documents.show"
    },
    {
      "path": [
        "documents",
        "export"
      ],
      "summary": "write an imported document to a new Markdown file",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "documents.export"
    },
    {
      "path": [
        "documents",
        "history"
      ],
      "summary": "list the versions of a document kept in the local copy, or show one with…",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "documents.history"
    },
    {
      "path": [
        "documents",
        "context"
      ],
      "summary": "show a document with its tags, relationships, notes, memories and editors",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "documents.context"
    },
    {
      "path": [
        "changes"
      ],
      "summary": "list the documents the sync added, changed, removed or brought back, newest…",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "changes"
    },
    {
      "path": [
        "search"
      ],
      "summary": "search imported documents by words, and by meaning when indexed",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "search"
    },
    {
      "path": [
        "catalog",
        "import"
      ],
      "summary": "put cached file and folder metadata into the shared database",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "catalog.import"
    },
    {
      "path": [
        "catalog",
        "show"
      ],
      "summary": "show stored metadata and the stable file or folder reference",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "catalog.show",
      "entity": "document"
    },
    {
      "path": [
        "catalog",
        "list"
      ],
      "summary": "list cached files and folders using metadata queries",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "catalog.list",
      "entity": "document"
    },
    {
      "path": [
        "catalog",
        "search"
      ],
      "summary": "search cached names, descriptions, types and observed people",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "catalog.search",
      "entity": "document"
    },
    {
      "path": [
        "catalog",
        "tree"
      ],
      "summary": "show the cached hierarchy below a folder or all selected roots",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "catalog.tree"
    },
    {
      "path": [
        "catalog",
        "tags",
        "list"
      ],
      "summary": "list local tags on a cached file or folder",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "catalog.tags.list",
      "entity": "document_tag"
    },
    {
      "path": [
        "catalog",
        "tags",
        "add"
      ],
      "summary": "add local tags on a cached file or folder",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "catalog.tags.add"
    },
    {
      "path": [
        "catalog",
        "tags",
        "remove"
      ],
      "summary": "remove local tags on a cached file or folder",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "catalog.tags.remove"
    },
    {
      "path": [
        "tags",
        "list"
      ],
      "summary": "list a document's tags",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "tags.list",
      "entity": "document_tag"
    },
    {
      "path": [
        "tags",
        "add"
      ],
      "summary": "tag a document",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "tags.add"
    },
    {
      "path": [
        "tags",
        "remove"
      ],
      "summary": "untag a document",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "tags.remove"
    },
    {
      "path": [
        "relationships",
        "list"
      ],
      "summary": "list a document's relationships",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "relationships.list",
      "entity": "document_relationship"
    },
    {
      "path": [
        "relationships",
        "add"
      ],
      "summary": "connect a document to another reference",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "relationships.add"
    },
    {
      "path": [
        "relationships",
        "remove"
      ],
      "summary": "remove one of a document's relationships",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "relationships.remove"
    },
    {
      "path": [
        "notes",
        "add"
      ],
      "summary": "write a note about a document",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "notes.add",
      "entity": "note"
    },
    {
      "path": [
        "notes",
        "list"
      ],
      "summary": "list a document's notes",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "notes.list",
      "entity": "note"
    },
    {
      "path": [
        "notes",
        "show"
      ],
      "summary": "show one note",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "notes.show",
      "entity": "note"
    },
    {
      "path": [
        "notes",
        "edit"
      ],
      "summary": "replace a note's text",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "notes.edit",
      "entity": "note"
    },
    {
      "path": [
        "notes",
        "remove"
      ],
      "summary": "delete one note",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "notes.remove"
    },
    {
      "path": [
        "memories",
        "add"
      ],
      "summary": "record a memory about a document",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "memories.add"
    },
    {
      "path": [
        "memories",
        "list"
      ],
      "summary": "list a document's memories",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "memories.list",
      "entity": "memory"
    },
    {
      "path": [
        "memories",
        "show"
      ],
      "summary": "show one memory",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "memories.show"
    },
    {
      "path": [
        "memories",
        "confirm"
      ],
      "summary": "confirm a proposed memory as true",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "memories.confirm"
    },
    {
      "path": [
        "memories",
        "stale"
      ],
      "summary": "mark a memory as out of date",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "memories.stale"
    },
    {
      "path": [
        "memories",
        "search"
      ],
      "summary": "search a document's memories by words",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "memories.search",
      "entity": "memory"
    },
    {
      "path": [
        "memories",
        "extract"
      ],
      "summary": "send a document's text to the model and show the memories it proposes",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "memories.extract"
    },
    {
      "path": [
        "facts",
        "add"
      ],
      "summary": "record a fact a document shows",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "facts.add"
    },
    {
      "path": [
        "facts",
        "list"
      ],
      "summary": "list a document's facts",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "facts.list",
      "entity": "fact"
    },
    {
      "path": [
        "facts",
        "show"
      ],
      "summary": "show one fact",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "facts.show"
    },
    {
      "path": [
        "facts",
        "confirm"
      ],
      "summary": "confirm a proposed fact; a decision it supersedes stops holding",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "facts.confirm"
    },
    {
      "path": [
        "facts",
        "reverse"
      ],
      "summary": "an accepted decision no longer holds, and nothing replaced it",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "facts.reverse"
    },
    {
      "path": [
        "identities",
        "list"
      ],
      "summary": "list the people Yandex Disk shows for a document",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "identities.list",
      "entity": "document_identity"
    },
    {
      "path": [
        "identities",
        "link"
      ],
      "summary": "record that a Yandex Disk account belongs to a known person",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "identities.link"
    },
    {
      "path": [
        "files",
        "list"
      ],
      "summary": "list what a Disk folder holds, live, a page at a time",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "files.list",
      "entity": "disk_item"
    },
    {
      "path": [
        "files",
        "show"
      ],
      "summary": "show one file or folder on the Disk, live",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "files.show",
      "entity": "disk_item"
    },
    {
      "path": [
        "files",
        "download"
      ],
      "summary": "read a Disk file's text, or save the file on this computer",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "files.download",
      "entity": "disk_item"
    },
    {
      "path": [
        "files",
        "upload"
      ],
      "summary": "put a local file on the Disk",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "files.upload"
    },
    {
      "path": [
        "files",
        "copy"
      ],
      "summary": "copy a file or folder on the Disk",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "files.copy"
    },
    {
      "path": [
        "files",
        "move"
      ],
      "summary": "move a file or folder on the Disk",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "files.move"
    },
    {
      "path": [
        "files",
        "create"
      ],
      "summary": "create a folder on the Disk at this path",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "files.create"
    },
    {
      "path": [
        "files",
        "delete"
      ],
      "summary": "move a file or folder to the Disk's trash; files restore brings it back",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "files.delete"
    },
    {
      "path": [
        "files",
        "publish"
      ],
      "summary": "open a file or folder to anyone with its public link; asks as files.share does",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "files.publish"
    },
    {
      "path": [
        "files",
        "unpublish"
      ],
      "summary": "close a file's or folder's public link; asks as files.share does",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "files.unpublish"
    },
    {
      "path": [
        "files",
        "serve"
      ],
      "summary": "show a Disk folder as a read-only folder on this computer, until Ctrl-C",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "files.serve"
    },
    {
      "path": [
        "files",
        "sheets",
        "show"
      ],
      "summary": "show a workbook's cells and the sha256 to edit them at",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "files.sheets.show"
    },
    {
      "path": [
        "files",
        "sheets",
        "update"
      ],
      "summary": "write values into a workbook's cells, at the sha256 it was read at",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "files.sheets.update"
    },
    {
      "path": [
        "files",
        "sheets",
        "create"
      ],
      "summary": "create a new workbook from rows of values and formulas",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "files.sheets.create"
    },
    {
      "path": [
        "files",
        "documents",
        "show"
      ],
      "summary": "show a document's paragraphs and the sha256 to edit them at",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "files.documents.show"
    },
    {
      "path": [
        "files",
        "documents",
        "update"
      ],
      "summary": "replace, insert or delete paragraphs, at the sha256 it was read at",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "files.documents.update"
    },
    {
      "path": [
        "files",
        "documents",
        "create"
      ],
      "summary": "create a new Word document from paragraphs and tables",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "files.documents.create"
    },
    {
      "path": [
        "files",
        "history"
      ],
      "summary": "list the earlier versions of a file kept on this computer",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "files.history"
    },
    {
      "path": [
        "files",
        "restore"
      ],
      "summary": "bring a file back from the trash, or put back a version kept here",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "files.restore"
    },
    {
      "path": [
        "files",
        "update"
      ],
      "summary": "replace a Yandex Disk file's text, or create a text file",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "files.update"
    },
    {
      "path": [
        "mirrors",
        "add"
      ],
      "summary": "mirror a local folder and a Disk folder both ways",
      "effects": {
        "remote": "read",
        "local": "write"
      },
      "permission": "mirrors.add"
    },
    {
      "path": [
        "mirrors",
        "list"
      ],
      "summary": "list this profile's mirrors",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "mirrors.list"
    },
    {
      "path": [
        "mirrors",
        "status"
      ],
      "summary": "show what the next sync would send from local changes",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "mirrors.status"
    },
    {
      "path": [
        "mirrors",
        "preview"
      ],
      "summary": "list Yandex Disk and show what mirrors sync would do",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "mirrors.preview"
    },
    {
      "path": [
        "mirrors",
        "sync"
      ],
      "summary": "sync mirrors both ways once",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "mirrors.sync"
    },
    {
      "path": [
        "mirrors",
        "watch"
      ],
      "summary": "keep syncing both ways until Ctrl-C or --timeout",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "mirrors.watch"
    },
    {
      "path": [
        "mirrors",
        "update"
      ],
      "summary": "add paths a mirror ignores, or clear the list; nothing is deleted on either side",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "mirrors.update"
    },
    {
      "path": [
        "mirrors",
        "remove"
      ],
      "summary": "stop mirroring a folder; nothing on either side changes",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "mirrors.remove"
    },
    {
      "path": [
        "mirrors",
        "versions",
        "list"
      ],
      "summary": "list what syncs did to a mirrored file, oldest first",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "mirrors.versions.list"
    },
    {
      "path": [
        "mirrors",
        "versions",
        "restore"
      ],
      "summary": "put a kept version back into the local folder",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "mirrors.versions.restore"
    },
    {
      "path": [
        "mirrors",
        "conflicts",
        "list"
      ],
      "summary": "list the conflicts the last sync left",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "mirrors.conflicts.list"
    },
    {
      "path": [
        "mirrors",
        "conflicts",
        "show"
      ],
      "summary": "show a conflict's three versions and the lines that conflict",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "mirrors.conflicts.show"
    },
    {
      "path": [
        "mirrors",
        "conflicts",
        "resolve"
      ],
      "summary": "settle a conflict on both sides: keep a side, both, or the final file",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "mirrors.conflicts.resolve"
    },
    {
      "path": [
        "store",
        "info"
      ],
      "summary": "the shared store's format, size and contents, and whether this tool can read it",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "permission": "store.info",
      "entity": "store_info"
