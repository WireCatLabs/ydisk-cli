  "network": {
    "hosts": [
      "cloud-api.yandex.net",
      "downloader.disk.yandex.ru",
      "*.disk.yandex.net",
      "*.storage.yandex.net",
      "registry.npmjs.org",
      "huggingface.co",
      "*.huggingface.co",
      "*.hf.co",
      "github.com",
      "*.githubusercontent.com"
    ]
  },
  "desktop": {
    "tagline": "Search your Yandex Disk folders and work with the files",
    "profiles": {
      "args": [
        "session",
        "list",
        "--no-record",
        "--json"
      ],
      "shape": "items"
    },
    "doctor": [
      "{profile}",
      "doctor",
      "--record",
      "--json"
    ],
    "runs": {
      "list": [
        "runs",
        "list",
        "{query}",
        "--limit",
        "{limit}",
        "--page",
        "{page}",
        "--no-record",
        "--json"
      ],
      "show": [
        "runs",
        "show",
        "{run}",
        "--no-record",
        "--json"
      ]
    },
    "search": null,
    "setup": [
      "{profile}",
      "session",
      "start"
    ],
    "signIn": {
      "gives": "Lets your agent read, search and change the files on your Yandex Disk through ydisk.",
      "asks": "A Yandex OAuth token with Disk access, pasted once and kept in the system keyring.",
      "methods": [
        {
          "id": "token",
          "label": "Yandex OAuth token",
          "words": [
            "{profile}",
            "session",
            "start",
            "--json"
          ],
          "stdin": true,
          "password": "YDISK_TOKEN"
        }
      ]
    },
    "skill": {
      "status": [
        "skill",
        "status",
        "--no-record",
        "--json"
      ],
      "install": [
        "skill",
        "install",
        "--for",
        "{target}",
        "--json"
      ],
      "show": [
        "skill",
        "show",
        "--no-record",
        "--json"
      ]
    },
    "mcpServer": {
      "port": 8760,
      "start": [
        "mcp",
        "server",
        "start",
        "--port",
        "{port}",
        "--public-url",
        "{url}",
        "--profiles",
        "all",
        "--json"
      ],
      "stop": [
        "mcp",
        "server",
        "stop",
        "--profiles",
        "all",
        "--json"
      ],
      "status": [
        "mcp",
        "server",
        "status",
        "--profiles",
        "all",
        "--no-record",
        "--json"
      ],
      "revoke": [
        "mcp",
        "revoke",
        "--profiles",
        "all",
        "--json"
      ],
      "config": [
        "mcp",
        "config",
        "--profiles",
        "all",
        "--no-record",
        "--json"
      ]
    },
    "tasks": null,
    "sync": {
      "run": [
        "{profile}",
        "sync",
        "--record",
        "--json"
      ],
      "last": [
        "runs",
        "list",
        "command:sync",
        "status:success",
        "--limit",
        "50",
        "--no-record",
        "--json"
      ],
      "lastShape": "runs",
      "what": "files in the Disk folders you choose",
      "note": null
    },
    "storeInfo": null,
    "storeTables": null,
    "storeTableSizes": null,
    "storeCheck": null,
    "storeBackup": null,
    "storeBackupEncrypted": null,
    "storeResetPreview": null,
    "storeReset": null,
    "storage": {
      "app": "yandex-disk-cli",
      "env": "YDISK"
    },
    "settings": null,
    "accountRemove": {
      "signOut": [
        "{profile}",
        "session",
        "end",
        "--record",
        "--json"
      ],
      "remove": {
        "minVersion": "0.0.0",
        "keepData": [
          "{profile}",
          "account",
          "remove",
          "--keep-data",
          "--record",
          "--json"
        ],
        "deleteData": [
          "{profile}",
          "account",
          "remove",
          "--delete-data",
          "--record",
          "--json"
        ],
        "dryRun": "--dry-run",
        "confirm": "--yes"
      },
      "removes": [
        "signIn"
      ],
      "keeps": [
        "settings",
        "data",
        "listed"
      ]
    }
  }
}
